# =============================================================================
# Ruutuli Cosplay — Environment Variables
# Copy this file to `.env` and fill in your values.
# NEVER commit `.env` to git.
# =============================================================================

# Site URL (used for absolute URLs in metadata when deployed)
NEXT_PUBLIC_SITE_URL=https://ruutuli.com

# Node environment
NODE_ENV=development

# =============================================================================
# Google Drive — Service Account (pick ONE approach)
# =============================================================================
# Required for listing images from your Drive folders and for the image proxy.
# Create a service account in Google Cloud Console, enable the Drive API,
# then share your cosplay folders with the service account email (Viewer).

# 1) JSON file path (recommended locally):
# GOOGLE_SERVICE_ACCOUNT_JSON_PATH=./service-account.json
# GOOGLE_APPLICATION_CREDENTIALS=C:/absolute/path/to/service-account.json

# 2) Inline JSON or base64-encoded JSON:
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# 3) Flat vars (same fields as the .json file — works well in .env):
# GOOGLE_CLIENT_EMAIL=your-bot@project.iam.gserviceaccount.com
# GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
#
# Or use the raw JSON field names directly:
# client_email=your-bot@project.iam.gserviceaccount.com
# private_key="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# =============================================================================
# Google Drive — API Key (optional fallback)
# =============================================================================
# For images shared as "Anyone with the link" without granting the service
# account access to each file. Enable "Google Drive API" in Cloud Console.
# GOOGLE_API_KEY=your_google_cloud_api_key_here

# =============================================================================
# Google Drive — Cosplay Image Folder
# =============================================================================
# One root folder URL. Each character/build should be a subfolder inside it.
# The admin picker lets you browse subfolders; search scans the whole tree.

# GOOGLE_DRIVE_COSPLAY_FOLDER_ID=https://drive.google.com/drive/folders/YOUR_FOLDER_ID

# Optional: separate WIP folder (legacy — not needed if WIP lives in a subfolder)
# GOOGLE_DRIVE_WIP_FOLDER_ID=https://drive.google.com/drive/folders/YOUR_WIP_FOLDER_ID

# =============================================================================
# Image Proxy Settings
# =============================================================================
# Max bytes per image served by /api/images/proxy (default 8MB, hard cap 32MB)
# IMAGE_PROXY_MAX_BYTES=8388608

# Debug logging for Drive/proxy (optional)
# DEBUG=true

# =============================================================================
# MongoDB
# =============================================================================
# Atlas connection string (from Atlas → Connect → Drivers)
# MONGODB_URI=mongodb+srv://user:password@cluster0.xxxxx.mongodb.net

# Or set these separately (cluster host only, no mongodb+srv:// prefix):
# MONGODB_USERNAME=your_db_user
# MONGODB_PASSWORD=your_db_password
# MONGODB_CLUSTER=cluster0.xxxxx.mongodb.net
# Database name (default: ruutuli)
# MONGODB_DB_NAME=ruutuli

# =============================================================================
# Admin dashboard
# =============================================================================
# Required to sign in at /admin/login
# ADMIN_PASSWORD=choose-a-strong-password
# ADMIN_SESSION_SECRET=long-random-string-for-cookie-signing

# =============================================================================
# Railway deployment (set these in the Railway service Variables tab)
# =============================================================================
# NODE_ENV=production
# NEXT_PUBLIC_SITE_URL=https://ruutuli.com
#
# MongoDB — use Railway MongoDB plugin or MongoDB Atlas:
# MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net
# MONGODB_DB_NAME=ruutuli
#
# Google Drive — use flat env vars (file paths won't work in containers):
# GOOGLE_CLIENT_EMAIL=your-bot@project.iam.gserviceaccount.com
# GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# GOOGLE_DRIVE_COSPLAY_FOLDER_ID=https://drive.google.com/drive/folders/YOUR_FOLDER_ID
#
# Custom domain (ruutuli.com):
# 1. Railway → Service → Settings → Networking → Custom Domain → add ruutuli.com and www.ruutuli.com
# 2. At your DNS provider, point ruutuli.com to Railway (CNAME to your *.up.railway.app hostname,
#    or use Railway's A records for apex). See Railway docs for your registrar.
# 3. Enable HTTPS in Railway (automatic once DNS propagates).